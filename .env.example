# Copy to .env for local development. Never commit real values.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=tracker
# Host port for the local compose database (change if 5432 is already taken)
DB_PORT=5432
DATABASE_URL=postgres://tracker:change-me-locally@localhost:5432/tracker
TEST_DATABASE_URL=postgres://tracker:change-me-locally@localhost:5432/tracker_test
NODE_ENV=development
PORT=3000
