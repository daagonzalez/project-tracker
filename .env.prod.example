# Production settings for the Raspberry Pi. Copy to .env on the Pi (chmod 600). Never commit real values.
POSTGRES_PASSWORD=change-me
POSTGRES_USER=tracker
POSTGRES_DB=tracker
TRACKER_HOSTNAME=tracker.daagonzalez.com
# Cloudflare API token scoped to Zone:DNS:Edit and Zone:Zone:Read on the one zone. Set it on the Pi only.
CLOUDFLARE_API_TOKEN=paste-token-on-the-pi-only
