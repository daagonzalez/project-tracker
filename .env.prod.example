# Production settings for the Raspberry Pi. Copy to .env on the Pi (chmod 600). Never commit real values.
# Connection string for the EXISTING Postgres server (13 or newer), using a dedicated database and role.
# URL-encode special characters in the password (@ becomes %40, / becomes %2F, and so on).
# Add ?sslmode=require if the server requires TLS.
DATABASE_URL=postgres://tracker:change-me@db-host.example:5432/tracker
TRACKER_HOSTNAME=tracker.daagonzalez.com
# Cloudflare API token scoped to Zone:DNS:Edit and Zone:Zone:Read on the one zone. Set it on the Pi only.
CLOUDFLARE_API_TOKEN=paste-token-on-the-pi-only
